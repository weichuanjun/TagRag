# ===== LLM（任意 OpenAI 兼容服务）=====
TAGRAG_LLM_BASE_URL=https://api.openai.com/v1
TAGRAG_LLM_API_KEY=
TAGRAG_LLM_MODEL=gpt-4o-mini

# ===== Embedding =====
# openai: 走 OpenAI 兼容 /embeddings（推荐中文：bge-m3、text-embedding-v3 等）
# local : 本地 sentence-transformers（需 pip install sentence-transformers），如 BAAI/bge-small-zh-v1.5
# hash  : 仅开发测试
TAGRAG_EMBEDDING_PROVIDER=openai
TAGRAG_EMBEDDING_MODEL=text-embedding-3-small
# TAGRAG_EMBEDDING_BASE_URL=
# TAGRAG_EMBEDDING_API_KEY=

# ===== 存储 =====
TAGRAG_DATA_DIR=./data
# TAGRAG_DATABASE_URL=postgresql+psycopg://user:pass@db:5432/tagrag

# ===== 安全 =====
# 设置后所有接口需带 X-API-Key；用户组通过网关注入 X-User-Groups（含 admin 才能管理）
# TAGRAG_API_KEYS=key1,key2
# TAGRAG_CORS_ORIGINS=https://kb.example.com

# ===== 检索调参 =====
# TAGRAG_TAG_BOOST=0.35
# TAGRAG_FINAL_TOP_K=8
# TAGRAG_CONTEXT_TOKEN_BUDGET=3000
# TAGRAG_CANDIDATE_AUTO_PROMOTE=0
