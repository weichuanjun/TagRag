# ===== LLM（默认 Claude）=====
TAGRAG_LLM_PROVIDER=claude
# 凭证：写在本文件里请用 TAGRAG_ANTHROPIC_API_KEY（.env 只加载 TAGRAG_ 开头的变量）；
# 也可以不写在这里，而是在系统环境变量中设置 ANTHROPIC_API_KEY，或执行 `ant auth login`
TAGRAG_ANTHROPIC_API_KEY=
TAGRAG_CLAUDE_MODEL=claude-opus-5-5
# 作答思考深度 low/medium/high/xhigh/max；打标默认 low
TAGRAG_CLAUDE_EFFORT=medium
TAGRAG_TAGGING_EFFORT=low
# 改用 OpenAI 兼容服务时：TAGRAG_LLM_PROVIDER=openai，并设置下面三项
# TAGRAG_LLM_BASE_URL=https://api.openai.com/v1
# TAGRAG_LLM_API_KEY=
# TAGRAG_LLM_MODEL=gpt-4o-mini

# ===== Embedding（Claude 没有 embedding 接口）=====
# voyage: Voyage AI（Anthropic 推荐），需 TAGRAG_EMBEDDING_API_KEY，模型名以 Voyage 官网当前列表为准
# local : 本地 sentence-transformers（需 pip install sentence-transformers），如 BAAI/bge-m3（日中英皆可）
# openai: OpenAI 兼容 /embeddings
# hash  : 仅开发测试
TAGRAG_EMBEDDING_PROVIDER=voyage
TAGRAG_EMBEDDING_MODEL=voyage-3.5
# TAGRAG_EMBEDDING_API_KEY=
# TAGRAG_EMBEDDING_BASE_URL=

# ===== 存储 =====
TAGRAG_DATA_DIR=./data
# TAGRAG_DATABASE_URL=postgresql+psycopg://user:pass@db:5432/tagrag

# ===== 安全 =====
# 设置后所有接口需带 X-API-Key；用户组通过网关注入 X-User-Groups（含 admin 才能管理）
# TAGRAG_API_KEYS=key1,key2
# TAGRAG_CORS_ORIGINS=https://kb.example.com

# ===== 检索调参 =====
# TAGRAG_TAG_BOOST=0.35
# TAGRAG_FINAL_TOP_K=8
# TAGRAG_CONTEXT_TOKEN_BUDGET=3000
# TAGRAG_CANDIDATE_AUTO_PROMOTE=0
